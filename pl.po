#. Upgrade card - name (weapon_avd)
#. source: AVD Logo
msgid "UPGRADE.weapon_avd.name"
msgstr "Logo AVD"

#. Upgrade card - description (weapon_avd)
#. source: Shoots a giant AVD logo towards the nearest enemy.
msgid "UPGRADE.weapon_avd.description"
msgstr "Wystrzeliwuje gigantyczne logo AVD w kierunku najbliższego wroga."

#. Upgrade card - name (weapon_bubbles)
#. source: Bubbles
msgid "UPGRADE.weapon_bubbles.name"
msgstr "Bąbelki"

#. Upgrade card - description (weapon_bubbles)
#. source: Giant bubbles float around that add stacks of Infect to enemies.
msgid "UPGRADE.weapon_bubbles.description"
msgstr ""
"Gigantyczne Bańki unoszą się w powietrzu, które nakładają i kumulują u "
"wrogów efekt Infekcji."

#. Upgrade card - name (weapon_cdrive)
#. source: C: Drive
msgid "UPGRADE.weapon_cdrive.name"
msgstr "Dysk C:"

#. Upgrade card - description (weapon_cdrive)
#. source: Drops harddrives randomly on enemies.
msgid "UPGRADE.weapon_cdrive.description"
msgstr "Losowo zrzuca dyski twarde na przeciwników."

#. Upgrade card - name (weapon_cut)
#. source: Cut
msgid "UPGRADE.weapon_cut.name"
msgstr "Cięcie"

#. Upgrade card - description (weapon_cut)
#. source: Scissors slice through the nearest enemy.
msgid "UPGRADE.weapon_cut.description"
msgstr "Nożyczki przecinają najbliższego wroga."

#. Upgrade card - name (weapon_firewall)
#. source: Firewall
msgid "UPGRADE.weapon_firewall.name"
msgstr "Zap. Ogniowa"

#. Upgrade card - description (weapon_firewall)
#. source: Creates a ring of fire around the player that adds stacks of Heat to enemies.
msgid "UPGRADE.weapon_firewall.description"
msgstr ""
"Tworzy wokół gracza pierścień ognia, który nakłada i kumuluje u wrogów efekt "
"Przegrzania."

#. Upgrade card - name (weapon_fontart)
#. source: FontArt
msgid "UPGRADE.weapon_fontart.name"
msgstr ""

#. Upgrade card - description (weapon_fontart)
#. source: Drops letters on the strongest enemy that add stacks of Heat to enemies.
msgid "UPGRADE.weapon_fontart.description"
msgstr ""
"Zrzuca litery na najsilniejszego wroga, które nakładają i kumulującą u "
"wrogów efekt Przegrzania."

#. Upgrade card - name (weapon_hitmarkers)
#. source: HaD: DoCK
msgid "UPGRADE.weapon_hitmarkers.name"
msgstr ""

#. Upgrade card - description (weapon_hitmarkers)
#. source: Shots land on the nearest enemy. 3% chance of a headshot.
msgid "UPGRADE.weapon_hitmarkers.description"
msgstr "Strzela do najbliższego wroga. 3% szansy na headshota."

#. Upgrade card - name (weapon_paint)
#. source: Paint
msgid "UPGRADE.weapon_paint.name"
msgstr ""

#. Upgrade card - description (weapon_paint)
#. source: Paints circles near the player that damage and add stacks of Lag to enemies over time.
msgid "UPGRADE.weapon_paint.description"
msgstr ""
"Tworzy wokół gracza okręgi, które zadają obrażenia i nakładają na wrogów "
"kumulujący efekt Opóźnienia."

#. Upgrade card - name (weapon_pinball)
#. source: Pinball
msgid "UPGRADE.weapon_pinball.name"
msgstr ""

#. Upgrade card - description (weapon_pinball)
#. source: Shoots a bouncing ball towards the nearest enemy.
msgid "UPGRADE.weapon_pinball.description"
msgstr "Wystrzeliwuje odbijającą się piłkę w kierunku najbliższego wroga."

#. Upgrade card - name (weapon_quarantine)
#. source: Quarantine
msgid "UPGRADE.weapon_quarantine.name"
msgstr "Kwarantanna"

#. Upgrade card - description (weapon_quarantine)
#. source: Scans an area around the player damaging enemies.
msgid "UPGRADE.weapon_quarantine.description"
msgstr "Skanuje obszar wokół gracza, zadawając wrogom obrażenia."

#. Upgrade card - name (weapon_search)
#. source: Search
msgid "UPGRADE.weapon_search.name"
msgstr "Szukaj"

#. Upgrade card - description (weapon_search)
#. source: Sends out a magnifying glass around the player.
msgid "UPGRADE.weapon_search.description"
msgstr "Wysyła lupę która kręci się wokół gracza."

#. Upgrade card - name (weapon_solitaire)
#. source: Solitaire
msgid "UPGRADE.weapon_solitaire.name"
msgstr "Pasjans"

#. Upgrade card - description (weapon_solitaire)
#. source: Shoots a bouncing card that adds stacks of Infect to enemies.
msgid "UPGRADE.weapon_solitaire.description"
msgstr ""
"Wystrzeliwuje odbijające się karty, które nakładają na wrogów kumulujący "
"efekt Infekcji."

#. Upgrade card - name (weapon_fraps)
#. source: Frames
msgid "UPGRADE.weapon_fraps.name"
msgstr "Klatki"

#. Upgrade card - description (weapon_fraps)
#. source: Fires flickering FPS numbers. The number shown is the damage dealt.
msgid "UPGRADE.weapon_fraps.description"
msgstr ""
"Wystrzeliwuje migoczące numery FPSów. Pokazana liczba oznacza ile obrażeń "
"klatka zada wrogom."

#. Upgrade card - name (weapon_scimitar)
#. source: Scimitar
msgid "UPGRADE.weapon_scimitar.name"
msgstr "Bułat"

#. Upgrade card - description (weapon_scimitar)
#. source: Slashes above and below the cursor. Extra amount adds alternating slashes.
msgid "UPGRADE.weapon_scimitar.description"
msgstr ""
"Ustawia ukośniki powyżej i poniżej kursora. Dodatkowa ilość dodaje "
"naprzemienne ukośniki."

#. Upgrade card - name (weapon_sniper)
#. source: Sniper 1.6
msgid "UPGRADE.weapon_sniper.name"
msgstr ""

#. Upgrade card - description (weapon_sniper)
#. source: One heavy shot at the strongest enemy. Clears show in a killfeed.
msgid "UPGRADE.weapon_sniper.description"
msgstr ""
"Jeden mocny strzał w najsilniejszego wroga. Oczyszczenia pokazywane są jako "
"lista zabójstw."

#. Upgrade card - name (weapon_minesweeper)
#. source: Mines
msgid "UPGRADE.weapon_minesweeper.name"
msgstr "Miny"

#. Upgrade card - description (weapon_minesweeper)
#. source: Tosses mines that plant, then explode when an enemy touches them.
msgid "UPGRADE.weapon_minesweeper.description"
msgstr "Rzuca miny, które się rozmieszczają i eksplodują, gdy wróg je dotknie."

#. Upgrade card - name (weapon_email)
#. source: Email
msgid "UPGRADE.weapon_email.name"
msgstr ""

#. Upgrade card - description (weapon_email)
#. source: Envelopes fly out, bounce off walls, and boomerang home hitting both ways.
msgid "UPGRADE.weapon_email.description"
msgstr ""
"Koperty wylatują, odbijają się od ścian, i wracają jak bumerang, raniąc "
"wrogów dwukrotnie."

#. Upgrade card - name (weapon_cruiser)
#. source: Internet Cruiser
msgid "UPGRADE.weapon_cruiser.name"
msgstr ""

#. Upgrade card - description (weapon_cruiser)
#. source: Opens a browser tab somewhere on screen. Lingers and applies heavy Lag.
msgid "UPGRADE.weapon_cruiser.description"
msgstr ""
"Otwiera zakładkę gdzieś na ekranie. Utrzymuje się i nakłada na wrogów silny "
"efekt Opóźnienia."

#. Upgrade card - name (weapon_orchestra)
#. source: Orchestra
msgid "UPGRADE.weapon_orchestra.name"
msgstr "Orkiestra"

#. Upgrade card - description (weapon_orchestra)
#. source: Opens a browser tab on the closest enemy on screen. Infects, and sometimes executes.
msgid "UPGRADE.weapon_orchestra.description"
msgstr ""
"Otwiera zakładkę na najbliższym wrogu na ekranie. Nakłada Infekcję i czasami "
"eliminuje."

#. Upgrade card - name (weapon_satellite)
#. source: WLAN
msgid "UPGRADE.weapon_satellite.name"
msgstr ""

#. Upgrade card - description (weapon_satellite)
#. source: Deploys a dish that pings nearby enemies with Lag signals.
msgid "UPGRADE.weapon_satellite.description"
msgstr "Rozstawia talerz który wysyłają pobliskim wrogom Opóźniające sygnały."

#. Upgrade card - name (weapon_avn)
#. source: AVN Chat
msgid "UPGRADE.weapon_avn.name"
msgstr "Chat AVN"

#. Upgrade card - description (weapon_avn)
#. source: Orbiting chat-bubble beams type out messages and Lag enemies.
msgid "UPGRADE.weapon_avn.description"
msgstr ""
"Okrążające kursor promieniujące dymki z czatem piszą wiadomości i nakładają "
"na wrogów efekt Opóźnienia."

#. Upgrade card - name (weapon_cone)
#. source: Very Large Cone
msgid "UPGRADE.weapon_cone.name"
msgstr "Bardzo Duży Pachołek"

#. Upgrade card - description (weapon_cone)
#. source: Orange traffic wedges stuck to you. They cook what they point at with Heat.
msgid "UPGRADE.weapon_cone.description"
msgstr ""
"Pomarańczowe pachołki drogowe są do ciebie przyczepione. Podpalają wszystko "
"na co są skierowane, nakładając efekt Przegrzania."

#. Upgrade card - name (weapon_blatand)
#. source: Blåtand
msgid "UPGRADE.weapon_blatand.name"
msgstr ""

#. Upgrade card - description (weapon_blatand)
#. source: Chains dashed Infect links between enemies at a fixed link length.
msgid "UPGRADE.weapon_blatand.description"
msgstr ""
"Rzuca złączone ze sobą Łańcuchy, o stałej długości, które po dotknięciu "
"nakładają na wrogów efekt Infekcji."

#. Upgrade card - name (weapon_modem)
#. source: Output Device
msgid "UPGRADE.weapon_modem.name"
msgstr "Urządzenie Wyjściowe"

#. Upgrade card - description (weapon_modem)
#. source: Blasts concentric handshake rings outward from the cursor.
msgid "UPGRADE.weapon_modem.description"
msgstr "Wysyła z kursora koncentryczne sygnały powitalne."

