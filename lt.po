#. Upgrade card - name (weapon_avd)
#. source: AVD Logo
msgid "UPGRADE.weapon_avd.name"
msgstr "AVD logotipas"

#. Upgrade card - description (weapon_avd)
#. source: Shoots a giant AVD logo towards the nearest enemy.
msgid "UPGRADE.weapon_avd.description"
msgstr "Paleidžia milžinišką AVD logotipą artimiausio priešo link."

#. Upgrade card - name (weapon_bubbles)
#. source: Bubbles
msgid "UPGRADE.weapon_bubbles.name"
msgstr "Burbulai"

#. Upgrade card - description (weapon_bubbles)
#. source: Giant bubbles float around that add stacks of Infect to enemies.
msgid "UPGRADE.weapon_bubbles.description"
msgstr "Aplink plaukioja milžiniški burbulai, kurie priešams prideda užkrėtimo sluoksnių."

#. Upgrade card - name (weapon_cdrive)
#. source: C: Drive
msgid "UPGRADE.weapon_cdrive.name"
msgstr "C: diskas"

#. Upgrade card - description (weapon_cdrive)
#. source: Drops harddrives randomly on enemies.
msgid "UPGRADE.weapon_cdrive.description"
msgstr "Atsitiktinai numeta kietuosius diskus ant priešų."

#. Upgrade card - name (weapon_cut)
#. source: Cut
msgid "UPGRADE.weapon_cut.name"
msgstr "Iškirpti"

#. Upgrade card - description (weapon_cut)
#. source: Scissors slice through the nearest enemy.
msgid "UPGRADE.weapon_cut.description"
msgstr "Žirklės perkerpa artimiausią priešą."

#. Upgrade card - name (weapon_firewall)
#. source: Firewall
msgid "UPGRADE.weapon_firewall.name"
msgstr "Ugniasienė"

#. Upgrade card - description (weapon_firewall)
#. source: Creates a ring of fire around the player that adds stacks of Heat to enemies.
msgid "UPGRADE.weapon_firewall.description"
msgstr "Aplink žaidėją sukuria ugnies žiedą, kuris priešams prideda kaitros sluoksnių."

#. Upgrade card - name (weapon_fontart)
#. source: FontArt
msgid "UPGRADE.weapon_fontart.name"
msgstr "FontArt"

#. Upgrade card - description (weapon_fontart)
#. source: Drops letters on the strongest enemy that add stacks of Heat to enemies.
msgid "UPGRADE.weapon_fontart.description"
msgstr "Ant stipriausio priešo numeta raides, kurios priešams prideda kaitros sluoksnių."

#. Upgrade card - name (weapon_hitmarkers)
#. source: HaD: DoCK
msgid "UPGRADE.weapon_hitmarkers.name"
msgstr "HaD: DoCK"

#. Upgrade card - description (weapon_hitmarkers)
#. source: Shots land on the nearest enemy. 3% chance of a headshot.
msgid "UPGRADE.weapon_hitmarkers.description"
msgstr "Šūviai pataiko į artimiausią priešą. 3% tikimybė pataikyti į galvą."

#. Upgrade card - name (weapon_paint)
#. source: Paint
msgid "UPGRADE.weapon_paint.name"
msgstr "Paint"

#. Upgrade card - description (weapon_paint)
#. source: Paints circles near the player that damage and add stacks of Lag to enemies over time.
msgid "UPGRADE.weapon_paint.description"
msgstr "Šalia žaidėjo nupiešia apskritimus, kurie laikui bėgant daro žalą ir priešams prideda lago sluoksnių."

#. Upgrade card - name (weapon_pinball)
#. source: Pinball
msgid "UPGRADE.weapon_pinball.name"
msgstr "Pinball"

#. Upgrade card - description (weapon_pinball)
#. source: Shoots a bouncing ball towards the nearest enemy.
msgid "UPGRADE.weapon_pinball.description"
msgstr "Paleidžia atšokantį kamuoliuką artimiausio priešo link."

#. Upgrade card - name (weapon_quarantine)
#. source: Quarantine
msgid "UPGRADE.weapon_quarantine.name"
msgstr "Karantinas"

#. Upgrade card - description (weapon_quarantine)
#. source: Scans an area around the player damaging enemies.
msgid "UPGRADE.weapon_quarantine.description"
msgstr "Nuskenuoja zoną aplink žaidėją ir sužeidžia priešus."

#. Upgrade card - name (weapon_search)
#. source: Search
msgid "UPGRADE.weapon_search.name"
msgstr "Paieška"

#. Upgrade card - description (weapon_search)
#. source: Sends out a magnifying glass around the player.
msgid "UPGRADE.weapon_search.description"
msgstr "Aplink žaidėją paleidžia didinamąjį stiklą."

#. Upgrade card - name (weapon_solitaire)
#. source: Solitaire
msgid "UPGRADE.weapon_solitaire.name"
msgstr "Pasjansas"

#. Upgrade card - description (weapon_solitaire)
#. source: Shoots a bouncing card that adds stacks of Infect to enemies.
msgid "UPGRADE.weapon_solitaire.description"
msgstr "Paleidžia atšokančią kortą, kuri priešams prideda užkrėtimo sluoksnių."

#. Upgrade card - name (weapon_fraps)
#. source: Frames
msgid "UPGRADE.weapon_fraps.name"
msgstr "Kadrai"

#. Upgrade card - description (weapon_fraps)
#. source: Fires flickering FPS numbers. The number shown is the damage dealt.
msgid "UPGRADE.weapon_fraps.description"
msgstr "Šaudo mirgančiais FPS skaičiais. Rodomas skaičius – padaryta žala."

#. Upgrade card - name (weapon_scimitar)
#. source: Scimitar
msgid "UPGRADE.weapon_scimitar.name"
msgstr "Kreivas kardas"

#. Upgrade card - description (weapon_scimitar)
#. source: Slashes above and below the cursor. Extra amount adds alternating slashes.
msgid "UPGRADE.weapon_scimitar.description"
msgstr "Kerta virš žymeklio ir po juo. Papildomas kiekis prideda besikaitaliojančių kirčių."

#. Upgrade card - name (weapon_sniper)
#. source: Sniper 1.6
msgid "UPGRADE.weapon_sniper.name"
msgstr "Snaiperis 1.6"

#. Upgrade card - description (weapon_sniper)
#. source: One heavy shot at the strongest enemy. Clears show in a killfeed.
msgid "UPGRADE.weapon_sniper.description"
msgstr "Vienas galingas šūvis į stipriausią priešą. Įveikti priešai rodomi nukovimų sąraše."

#. Upgrade card - name (weapon_minesweeper)
#. source: Mines
msgid "UPGRADE.weapon_minesweeper.name"
msgstr "Minos"

#. Upgrade card - description (weapon_minesweeper)
#. source: Tosses mines that plant, then explode when an enemy touches them.
msgid "UPGRADE.weapon_minesweeper.description"
msgstr "Mėto minas, kurios įsitvirtina ir sprogsta priešui jas palietus."

