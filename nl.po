#. Class select - name (brick)
#. source: Brick
msgid "CLASS.brick.name"
msgstr "Brick"

#. Class select - description (brick)
#. source: Add +40 Max HP.\nAdd +12 Armo(u)r.\nMultiply Cursor Speed 0.8x.\nMultiply Weapon Damage 0.85x.\nMultiply Weapon Damage 1.1x when taking Damage (Lasts 8s, stacks up to 3).
msgid "CLASS.brick.description"
msgstr ""
"+40 max HP.\n"
"+12 armor.\n"
"0.8x cursorsnelheid.\n"
"0.85x wapenschade.\n"
"1.1x wapenschade als je geraakt wordt (8s, stackt tot 3x)."

#. Class select - name (default)
#. source: Default
msgid "CLASS.default.name"
msgstr "Standaard"

#. Class select - description (default)
#. source: No class bonuses or penalties.\nBalanced baseline cursor.
msgid "CLASS.default.description"
msgstr ""
"Geen classbonussen of -nadelen.\n"
"Een gebalanceerde basiscursor."

#. Class select - name (null)
#. source: Null
msgid "CLASS.null.name"
msgstr "Null"

#. Class select - description (null)
#. source: Reduce Max HP -25.\nAdd +8 Packet Loss.\nMultiply Luck 1.5x.\nMultiply Weapon Damage 0.9x.
msgid "CLASS.null.description"
msgstr ""
"-25 max HP.\n"
"+8 packet loss.\n"
"1.5x geluk.\n"
"0.9x wapenschade."

#. Class select - name (vector)
#. source: Vector
msgid "CLASS.vector.name"
msgstr "Vector"

#. Class select - description (vector)
#. source: Multiply Cursor Speed 1.25x.\nAdd +15 Packet Loss.\nReduce Max HP -25.\nMultiply Weapon Damage 0.9x.\nMultiply Cursor Speed 1.25x and Refresh Speed 1.2x on Packet Loss (Lasts 4s).
msgid "CLASS.vector.description"
msgstr ""
"1.25x cursorsnelheid.\n"
"+15 packet loss.\n"
"-25 max HP.\n"
"0.9x wapenschade.\n"
"1.25x cursorsnelheid en 1.2x refreshsnelheid bij packet loss (4s)."

#. Class select - name (breakpoint)
#. source: Breakpoint
msgid "CLASS.breakpoint.name"
msgstr "Breakpoint"

#. Class select - description (breakpoint)
#. source: Increase Crit Chance +12%.\nMultiply Crit Damage 1.25x.\nReduce Max HP -15.\nMultiply Cursor Speed 0.9x.\nMultiply Weapon Damage 0.92x.
msgid "CLASS.breakpoint.description"
msgstr ""
"+12% critkans.\n"
"1.25x critschade.\n"
"-15 max HP.\n"
"0.9x cursorsnelheid.\n"
"0.92x wapenschade."

#. Class select - name (thread)
#. source: Thread
msgid "CLASS.thread.name"
msgstr "Thread"

#. Class select - description (thread)
#. source: Multiply Processing Speed 1.3x.\nMultiply Refresh Speed 1.12x.\nMultiply EXP Gain 1.08x.\nMultiply Weapon Damage 0.85x.
msgid "CLASS.thread.description"
msgstr ""
"1.3x verwerkingssnelheid.\n"
"1.12x refreshsnelheid.\n"
"1.08x EXP-bonus.\n"
"0.85x wapenschade."

#. Class select - name (admin)
#. source: Admin
msgid "CLASS.admin.name"
msgstr "Admin"

#. Class select - description (admin)
#. source: Start with +1 Key.\nMultiply Coin Gain 1.3x.\nMultiply Pickup Range 1.3x.\nDiscount Shop Items +10%.\nMultiply Max HP 0.9x.\nMultiply Weapon Damage 0.85x.
msgid "CLASS.admin.description"
msgstr ""
"Start met +1 key.\n"
"1.3x muntenbonus.\n"
"1.3x pickup-range.\n"
"+10% korting in de shop.\n"
"0.9x max HP.\n"
"0.85x wapenschade."

#. Folder evolution mode - name (chaos)
#. source: Chaos
msgid "EVO.chaos.name"
msgstr "Chaos"

#. Folder evolution mode - description (chaos)
#. source: A inconsistent unpredictable mess of difficulty. I couldn't tell you what to expect.
msgid "EVO.chaos.description"
msgstr ""
"Een onvoorspelbare chaos aan moeilijkheid. Ik kan je echt niet zeggen wat je "
"te wachten staat."

#. Folder evolution mode - name (linear)
#. source: Linear
msgid "EVO.linear.name"
msgstr "Lineair"

#. Folder evolution mode - description (linear)
#. source: A consistent linear stream of more enemies being added over time.
msgid "EVO.linear.description"
msgstr ""
"Er komen gelijkmatig steeds meer vijanden bij naarmate de tijd verstrijkt."

#. Folder evolution mode - name (variable)
#. source: Variable
msgid "EVO.variable.name"
msgstr "Variabel"

#. Folder evolution mode - description (variable)
#. source: A varied level of enemies that ramps up and down to give more moments of peace but harder increases.
msgid "EVO.variable.description"
msgstr ""
"Het aantal vijanden golft op en neer: meer rustige momenten, maar zwaardere "
"pieken."

